# Only packages/core/src/config.ts reads these. Never commit .env.
# LLM: "anthropic" needs ANTHROPIC_API_KEY; "claude-cli" uses the logged-in Claude Code CLI; "fake" uses fixtures.
VF_LLM=claude-cli
ANTHROPIC_API_KEY=
CLAUDE_BIN=
# TTS: "edge" (free, en-US voices, word timings) or "fake" (silence).
VF_TTS=edge
# Optional: stop a run when its LLM calls cost more than this many USD. Unset = no cap.
# VF_BUDGET_USD=5
# Remotion: browser tabs rendering in parallel (14 GB RAM machine: 2).
VF_RENDER_CONCURRENCY=2
VF_RUNS_DIR=runs
VF_LIBRARY_DIR=library
