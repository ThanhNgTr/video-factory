{
  "name": "vf",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "vf": "node apps/cli/src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "deps": "depcruise --config .dependency-cruiser.cjs packages modules apps",
    "test": "vitest run",
    "studio": "remotion studio modules/video/src/composition/entry.ts",
    "check": "tsc -p tsconfig.json --noEmit && biome check . && depcruise --config .dependency-cruiser.cjs packages modules apps && vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/three": "^0.187.0",
    "dependency-cruiser": "^17.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "@remotion/cli": "^4.0.543",
    "@vf/contracts": "workspace:*",
    "@vf/core": "workspace:*",
    "zod": "^4.6.7"
  }
}
